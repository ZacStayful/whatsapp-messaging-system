# =============================================================================
# Stayful WhatsApp Messaging System — environment template
# =============================================================================
#
# Copy to .env.local and fill in. `.env.local` is git-ignored; this file is the
# only .env* file that is ever committed, and it must never contain a real value.
#
#   cp .env.example .env.local
#   npm run check-env      # verifies every value actually works
#
# ENVIRONMENT.md explains, variable by variable, exactly which console screen
# each value comes from.
#
# Conventions used below:
#   [secret]        never commit, never log, never prefix NEXT_PUBLIC_
#   [client-safe]   inlined into the browser bundle by Next.js
#   [required]      the app refuses to boot without it
#   [optional]      absence degrades a specific behaviour, documented inline
#   [per-env]       differs between local / preview / production
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — database and auth
# Dashboard: https://supabase.com/dashboard → your project
# -----------------------------------------------------------------------------

# [client-safe] [required] [per-env]
# Project Settings → Data API → Project URL.
# Must be https and must have no trailing slash.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# [client-safe] [required] [per-env]
# Project Settings → API Keys → anon / publishable key.
# Safe in the browser: it carries no privileges beyond what RLS allows.
# Accepts either the legacy JWT (eyJ...) or the newer sb_publishable_... format.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [secret] [required] [per-env]
# Project Settings → API Keys → service_role / secret key.
# BYPASSES ROW LEVEL SECURITY. Server only. If this ever appears in a
# NEXT_PUBLIC_ variable, in client code, or in a commit, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# [required] [per-env]
# The 20-character project ref — the subdomain of the project URL above.
# Used by the Supabase CLI and by migrations.
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx

# [secret] [optional]
# Database password, set when the project was created (Project Settings →
# Database → Database password → reset if lost).
# Local migrations only. Do NOT set this in Vercel.
SUPABASE_DB_PASSWORD=


# -----------------------------------------------------------------------------
# Twilio — WhatsApp
# Console: https://console.twilio.com
# -----------------------------------------------------------------------------

# [required]
# Console dashboard → Account Info → Account SID. Starts "AC", 34 characters.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [secret] [required]
# Console dashboard → Account Info → Auth Token.
# Required even when outbound calls use an API key below: this is the key Twilio
# signs the X-Twilio-Signature header with, and every inbound webhook is
# verified against it.
TWILIO_AUTH_TOKEN=

# [optional]
# Account → API keys & tokens → Create API key (Standard). Starts "SK".
# Preferred for outbound API calls so the auth token can be rotated
# independently. Set both halves or neither.
TWILIO_API_KEY_SID=

# [secret] [optional]
# Shown exactly once, when the API key above is created. Not recoverable —
# create a new key if lost.
TWILIO_API_KEY_SECRET=

# [required] [per-env]
# The WhatsApp sender, in E.164 with a leading "+".
# This is the WhatsApp-enabled number, NOT the voice line.
# During development this may be the Twilio WhatsApp sandbox number.
TWILIO_WHATSAPP_NUMBER=+441234567890

# [optional]
# Messaging → Services → your service. Starts "MG".
# Leave unset if not using a Messaging Service; sending then goes direct from
# the number above.
TWILIO_MESSAGING_SERVICE_SID=


# -----------------------------------------------------------------------------
# Monday.com — CRM
# https://stayful.monday.com
# -----------------------------------------------------------------------------

# [secret] [required]
# Avatar (bottom left) → Administration → Connections → API, or
# Avatar → Developers → My Access Tokens. Personal API v2 token.
MONDAY_API_TOKEN=

# [required]
# Management Leads board. Found in the board URL: /boards/<id>
MONDAY_BOARD_ID=5891626711

# [secret] [required]
# The signing secret for the webhook integration, used to verify the JWT on
# every inbound Monday webhook request.
MONDAY_WEBHOOK_SIGNING_SECRET=

# [required]
# Column id of the Status column on the leads board.
MONDAY_STATUS_COLUMN_ID=status5

# [required]
# The exact label text that admits a lead to the system. Must match Monday
# character for character, including case — a near miss silently never fires.
MONDAY_QUALIFIED_STATUS_LABEL=Qualified

# [required]
# Comma-separated Monday group ids that must never sync and must never be
# messaged. Leads in these groups may have been sold to other operators;
# messaging them is a commercial problem, not a technical one.
#   topics            = Cold Management Leads
#   group_mkwhk3z9    = Leads that can be sold
#   group_mkwtw6he    = Abandoned Leads
#   group_mm1dtkdm    = Customer / signed
MONDAY_EXCLUDED_GROUP_IDS=topics,group_mkwhk3z9,group_mkwtw6he,group_mm1dtkdm


# -----------------------------------------------------------------------------
# Email and alerting — Resend
# Dashboard: https://resend.com
# -----------------------------------------------------------------------------

# [secret] [required]
# API Keys → Create API Key. Shown once. Starts "re_".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# [required]
# Where out-of-hours reply digests and system alerts are sent.
ALERT_EMAIL_TO=zac@stayful.co.uk

# [required]
# Sender address. Its domain must be verified in Resend → Domains, or delivery
# fails at send time rather than at boot.
# May be "Display Name <address@domain.com>".
ALERT_EMAIL_FROM=Stayful Alerts <alerts@stayful.co.uk>


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# [required] [per-env]
# local | preview | production
# Deliberately distinct from NODE_ENV: `next build` sets NODE_ENV=production on
# a preview deploy too, and preview must not behave like production.
APP_ENV=local

# [client-safe] [required] [per-env]
# Base URL of this app. Used for deep links in alert emails.
#   local      http://localhost:3000
#   preview    the Vercel preview URL
#   production https://<your-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [required] [per-env]
# Public URL that Twilio and Monday webhooks resolve to.
# In local development this is the Cloudflare tunnel hostname — NOT localhost,
# which neither provider can reach.
WEBHOOK_BASE_URL=https://tunnel.example.com

# [required outside production] [per-env]
# SAFETY RAIL. Comma-separated E.164 numbers.
# When APP_ENV is not "production" the send function refuses any number not on
# this list. Enforced inside the send function, never in the UI.
# Messaging a real lead during development burns the quality rating on a number
# that takes weeks to replace.
ALLOWED_TEST_NUMBERS=+447700900000

# [optional, defaults false]
# Master kill switch checked at boot. "true" or "false".
# Unset means false: a missing value must never mean "sending is on".
# A database-level switch arrives in a later phase; this is the boot-time one.
SEND_ENABLED=false

# [required]
# Working hours. Inside them, no email notifications — reps are in the app.
# Outside them, inbound replies are batched into a digest to ALERT_EMAIL_TO.
WORKING_HOURS_START=09:00
WORKING_HOURS_END=17:00

# [required]
# IANA timezone name. Must be used with a timezone-aware date library: a naive
# UTC comparison is an hour wrong for seven months of the year.
# "GMT", "BST" and "UTC+1" are all rejected.
WORKING_HOURS_TIMEZONE=Europe/London

# [secret] [required] [per-env]
# Shared secret authenticating Vercel cron invocations of the queue worker.
# Generate with: openssl rand -hex 32
CRON_SECRET=


# -----------------------------------------------------------------------------
# Deferred — not used yet. Leave commented out.
# Declared as explicitly optional in src/lib/env.ts so their absence degrades a
# feature rather than failing the boot.
# -----------------------------------------------------------------------------

# [secret] Calendly personal access token. Meeting-booking detection.
# CALENDLY_API_TOKEN=

# [secret] Calendly webhook signing key.
# CALENDLY_WEBHOOK_SIGNING_KEY=

# Sentry DSN. Error reporting.
# SENTRY_DSN=
