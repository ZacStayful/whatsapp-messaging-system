# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Everything matching .env* is ignored EXCEPT .env.example, which is the
# committed template. Never commit a file containing real credentials.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase cli
/supabase/.temp
/supabase/.branches

# editors
.idea/
.vscode/*
!.vscode/extensions.json
